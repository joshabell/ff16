{
  "name": "ff16-scoreboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply ff16-scoreboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply ff16-scoreboard --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261102.1": true
  }
}
